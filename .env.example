PORT=5000
NODE_ENV=development
# Public URL of the frontend (used in email links)
APP_URL=
# Public URL of this API (the mock payment provider uses it)
API_URL=http://localhost:5000

MONGO_URI=mongodb://127.0.0.1:27017/kobomarket
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kobomarket

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Payments: "paystack" (use sk_test_ keys in development) or "mock" (no Paystack account needed)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack sends the customer after paying (your frontend page)
PAYSTACK_CALLBACK_URL=
# Wallet funding limits in kobo (₦1 = 100 kobo)
WALLET_FUND_MIN_KOBO=10000
WALLET_FUND_MAX_KOBO=100000000
