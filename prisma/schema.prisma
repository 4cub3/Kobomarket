generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Money lives here, never in MongoDB. Every amount is a whole number of kobo
// stored as BIGINT (₦1 = 100 kobo).
//
// Sign convention for the double-entry ledger:
//   CREDIT = money arrives in an account, DEBIT = money leaves it, so
//   account balance = SUM(credits) - SUM(debits).
//
// Rules Prisma can't express are added as raw SQL in the migrations:
// CHECK constraints, the append-only trigger on ledger_entries, and the
// check that every transaction's debits equal its credits.
// -----------------------------------------------------------------------------

enum AccountOwnerType {
  USER // a person's wallet; owner_id is their MongoDB user _id
  SYSTEM // PLATFORM_ESCROW, PLATFORM_REVENUE, PLATFORM_PAYOUT_CLEARING
  EXTERNAL // money outside KoboMarket (Paystack); the only kind allowed below zero

  @@map("account_owner_type")
}

enum AccountStatus {
  ACTIVE
  FROZEN

  @@map("account_status")
}

enum TransactionType {
  FUNDING
  ORDER_PAYMENT
  ESCROW_RELEASE
  REFUND
  PAYOUT
  REVERSAL

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED

  @@map("transaction_status")
}

enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_status")
}

model Account {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType   AccountOwnerType @map("owner_type")
  ownerId     String           @map("owner_id") @db.VarChar(64)
  currency    String           @default("NGN") @db.VarChar(3)
  // Cached balance. It must always equal SUM(credits) - SUM(debits) of this
  // account's ledger entries (npm run audit:ledger checks it).
  balanceKobo BigInt           @default(0) @map("balance_kobo")
  status      AccountStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries LedgerEntry[]

  @@unique([ownerType, ownerId, currency])
  @@map("accounts")
}

// One business event that moves money (a funding, a checkout, a release...).
// Its ledger entries hold the actual debits and credits.
model LedgerTransaction {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference             String            @unique @db.VarChar(100)
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  amountKobo            BigInt            @map("amount_kobo")
  currency              String            @default("NGN") @db.VarChar(3)
  idempotencyKey        String?           @unique @map("idempotency_key") @db.VarChar(255)
  metadata              Json              @default("{}")
  // Set on a REVERSAL; unique, so a transaction can only ever be reversed once
  reversesTransactionId String?           @unique @map("reverses_transaction_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reverses   LedgerTransaction? @relation("TransactionReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy LedgerTransaction? @relation("TransactionReversal")
  entries    LedgerEntry[]

  @@index([type, status, createdAt])
  @@map("transactions")
}

// Append-only: the database rejects UPDATE and DELETE on this table.
model LedgerEntry {
  id               BigInt         @id @default(autoincrement())
  transactionId    String         @map("transaction_id") @db.Uuid
  accountId        String         @map("account_id") @db.Uuid
  direction        EntryDirection
  amountKobo       BigInt         @map("amount_kobo")
  // The account's balance right after this entry, for statements
  balanceAfterKobo BigInt         @map("balance_after_kobo")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, id])
  @@index([transactionId])
  @@map("ledger_entries")
}

// Remembers the response to a request sent with an Idempotency-Key header,
// so a retry gets the same answer instead of repeating the action.
model IdempotencyKey {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String            @map("user_id") @db.VarChar(64)
  scope          String            @db.VarChar(100)
  key            String            @db.VarChar(255)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, scope, key])
  @@map("idempotency_keys")
}
